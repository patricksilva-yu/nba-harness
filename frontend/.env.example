# Leave empty in development: Vite forwards /api to NBA_API_PROXY_TARGET.
VITE_API_BASE_URL=
# Where the dev server forwards /api requests (the FastAPI app).
NBA_API_PROXY_TARGET=http://127.0.0.1:8000
# Supabase Auth (Settings → API keys). Use the publishable key, never the secret
# or service-role key. Leave both empty to run without sign-in, alongside an API
# started with NBA_AUTH_MODE=disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
