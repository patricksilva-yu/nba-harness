      "updated": 1,
      "link": null,
      "locked": false,
      "text": "FastMCP Server\napi/nba_agent/mcp_server.py\n\nLLM-exposed tools:\n- resolve game\n- ensure local data\n- game snapshot\n- advanced context\n- decisive runs\n- possession summary\n- player context\n- evidence rehydrate\n\nReturns compact JSON:\nsummary + evidence_packets",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "FastMCP Server\napi/nba_agent/mcp_server.py\n\nLLM-exposed tools:\n- resolve game\n- ensure local data\n- game snapshot\n- advanced context\n- decisive runs\n- possession summary\n- player context\n- evidence rehydrate\n\nReturns compact JSON:\nsummary + evidence_packets",
      "lineHeight": 1.2,
      "baseline": 258
    },
