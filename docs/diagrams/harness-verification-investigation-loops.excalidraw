      "boundElements": [],
      "updated": 1790105310450,
      "link": null,
      "locked": false,
      "text": "LOOP = THE REPEATED WORK\nCheck a claim → get a missing stat if needed → revise → check again.\nRepeat only while it can improve the answer.",
