OPENAI_API_KEY=
NBA_OPENAI_MODEL=gpt-5.5
NBA_OPENAI_AGENT_MODE=mcp_harness
NBA_MCP_SERVER_URL=
NBA_OPENAI_AGENT_INSTRUCTIONS=
NBA_STORAGE_BACKEND=duckdb
# POSTGRES_CONNECTION_STRING is required only when NBA_STORAGE_BACKEND=postgres.
POSTGRES_CONNECTION_STRING=
# Optional non-public schema, primarily useful for isolated integration tests.
NBA_POSTGRES_SCHEMA=
# Raw upstream captures are retained for 60 days and deleted in bounded batches.
NBA_RAW_RESPONSE_RETENTION_DAYS=60
NBA_RAW_RESPONSE_RETENTION_BATCH_SIZE=500
# PostgreSQL pool defaults are 1-5 connections, 5s connect, and 10s statements.
NBA_DB_POOL_MIN=1
NBA_DB_POOL_MAX=5
NBA_DB_CONNECT_TIMEOUT_SECONDS=5
NBA_DB_STATEMENT_TIMEOUT_MS=10000
# Harness has no implicit model choice; NBA_OPENAI_MODEL above is explicit.
NBA_HARNESS_SECONDS=180
NBA_HARNESS_TOOL_CALLS=12
NBA_HARNESS_MODEL_TURNS=12
NBA_HARNESS_TOTAL_TOKENS=100000
# To enable a dollar cap, supply both rates for the configured model and cap:
# NBA_HARNESS_INPUT_USD_PER_MILLION=
# NBA_HARNESS_OUTPUT_USD_PER_MILLION=
# NBA_HARNESS_MAX_COST_USD=
